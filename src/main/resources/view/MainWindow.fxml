<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane prefHeight="600.0" prefWidth="400.0"
            styleClass="chat-root"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="penguinbot.MainWindow">
    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" vvalue="1.0">
            <content>
                <VBox fx:id="dialogContainer" spacing="10.0" fillWidth="true" prefWidth="400.0">
                    <padding>
                        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox spacing="8.0">
            <padding>
                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
            </padding>
            <TextField fx:id="userInput" HBox.hgrow="ALWAYS" onAction="#handleUserInput" promptText="Type a message..." />
            <Button fx:id="sendButton" text="Send" onAction="#handleUserInput" />
        </HBox>
    </bottom>
</BorderPane>
